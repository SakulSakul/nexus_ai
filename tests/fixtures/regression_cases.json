{
  "version": 2,
  "description": "Tier-1 회귀 — 라우팅/배지/classifier + OOS 게이트(택시 등) 캘리브레이션",
  "cases": [
    { "id": "external_audit_finance", "query": "외감규정 절차", "expect": { "classifier": "standard", "incident_nodes_exclude": ["정보보안", "회사정보"], "category": "재무" }, "note": "#284 외부 트리거 FP 회귀 — 정보보안 노드로 새면 FAIL" },
    { "id": "pii_leak_infosec", "query": "개인정보 유출", "expect": { "classifier": "critical", "category": "정보보안" } },
    { "id": "safety_report", "query": "안전사고 보고", "expect": { "category": "안전" } },
    { "id": "self_report_faq", "query": "자진 신고", "expect": { "classifier": "simple_faq" } },
    { "id": "harassment_hr", "query": "직장 내 괴롭힘", "expect": { "classifier": "standard", "incident_nodes_include": ["괴롭힘"], "category": "인사" }, "note": "주제어=standard (사건 프레이밍만 critical)" },
    { "id": "taxi_finance", "query": "택시 타도 됨?", "expect": { "classifier_not": "out_of_scope", "expect_retrieved_doc": "시내교통비" }, "note": "OOS 오분류 -> 시내교통비(재무) rescue; Tier-2 retrieval grounding" },
    { "id": "trip_finance_2c", "query": "출장", "expect": { "classifier": "standard", "expect_retrieved_doc": "출장비" }, "note": "통제군 2글자 — bare '출장' 존재 확인, PASS 예상" },
    { "id": "discipline_common_2c", "query": "징계", "expect": { "classifier_not": "out_of_scope", "expect_retrieved_doc": "징계기준" }, "note": "통제군 — '징계'는 simple_faq 가 정상(흔한 단순질의). OOS 아님 + 징계기준 검색만 검증" },
    { "id": "bribery_common_2c", "query": "뇌물", "expect": { "classifier_not": "out_of_scope", "expect_retrieved_doc": "징계기준" }, "note": "프로브 — 위반어 std/critical 모호로 classifier_not. 2글자 누수 점검" },
    { "id": "embezzle_common_2c", "query": "횡령", "expect": { "classifier_not": "out_of_scope", "expect_retrieved_doc": "징계기준" }, "note": "프로브 — 2글자 누수 점검" },
    { "id": "entertain_common_2c", "query": "접대", "expect": { "classifier_not": "out_of_scope", "expect_retrieved_doc": "징계기준" }, "note": "프로브 — 실제 doc 이 CREDO 일 수 있음, fail 시 SQL 로 제목 확인" },
    { "id": "audit_finance_2c", "query": "감사", "expect": { "classifier": "standard", "expect_retrieved_doc": "내부회계관리" }, "note": "'감사' → (재무) 내부회계관리규정 정상 검색 (콘솔 top-k 확인). 누수 아님" },
    { "id": "order_2c", "query": "발주", "expect": { "classifier": "standard", "expect_retrieved_doc": "구매 업무" }, "note": "발주↔구매 동의어(Admin 동의어 사전) 추가 후 (총무) 구매 업무 지침 검색. 미추가 시 fail = 동의어 등록 필요 신호" },
    { "id": "annual_leave_hr", "query": "연차", "expect": { "classifier_not": "critical" }, "note": "HR — standard/simple_faq/oos 모두 허용. critical FP 만 가드. 실경로 미발견/FAQ→인사교육팀" },
    { "id": "vacation_hr", "query": "휴가", "expect": { "classifier_not": "critical" }, "note": "HR — 승인 FAQ('휴가 신청 방법') 경로. critical FP 만 가드" },
    { "id": "eval_hr", "query": "평가", "expect": { "classifier_not": "critical" }, "note": "'평가'는 모호(리스크/공급사 평가 가능) — standard 합리. critical FP 만 가드" },
    { "id": "promotion_hr", "query": "승진", "expect": { "classifier_not": "critical" }, "note": "HR — standard→미발견→인사교육팀 fallback 이면 결과 정상. critical FP 만 가드" },
    { "id": "parking_oos", "query": "주차", "expect": { "classifier": "out_of_scope" }, "note": "#289 '회사 주차장' OOS 정합 — 총무" },
    { "id": "hiring_hr", "query": "채용", "expect": { "classifier_not": "critical" }, "note": "HR(채용) — fallback=인사교육팀. critical FP 만 가드" },
    { "id": "parking_admin", "query": "회사 주차장", "expect": { "classifier": "out_of_scope" }, "note": "주차 전용 사규 없음(급배기·실종아동 스치는 언급뿐). 게이트가 OOS 유지 = 정답. 스치는 언급에 과잉 rescue 안 하는지 지키는 가드" },
    { "id": "overtime_meal", "query": "야근 식대", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "company_car_accident", "query": "법인차량 사고", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "wedding_congrats", "query": "결혼 경조사비", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "meeting_room_oos", "query": "회의실 예약", "expect": { "classifier": "out_of_scope" } },
    { "id": "weather_oos", "query": "오늘 날씨", "expect": { "classifier": "out_of_scope" } },
    { "id": "salary_oos", "query": "내 연봉", "expect": { "classifier": "out_of_scope" } },
    { "id": "lunch_menu_oos", "query": "점심 메뉴", "expect": { "classifier": "out_of_scope" } },
    { "id": "vpn_oos", "query": "VPN 장애", "expect": { "classifier": "out_of_scope" } }
  ]
}
