{
  "version": 1,
  "description": "Tier-1 회귀 어서션 — 라우팅/배지/classifier 고속 검증 (LLM 합성 없음)",
  "cases": [
    {
      "id": "external_audit_finance",
      "query": "외감규정 절차",
      "expect": {
        "classifier": "standard",
        "incident_nodes_exclude": ["정보보안", "회사정보"],
        "category": "재무"
      },
      "note": "#284 외부 트리거 FP 회귀 — 정보보안 노드로 새면 FAIL"
    },
    {
      "id": "pii_leak_infosec",
      "query": "개인정보 유출",
      "expect": { "classifier": "critical", "category": "정보보안" }
    },
    {
      "id": "safety_report",
      "query": "안전사고 보고",
      "expect": { "category": "안전" }
    },
    {
      "id": "self_report_faq",
      "query": "자진 신고",
      "expect": { "classifier": "simple_faq" }
    },
    {
      "id": "harassment_hr",
      "query": "직장 내 괴롭힘",
      "expect": { "classifier": "critical", "incident_nodes_include": ["괴롭힘"], "category": "인사" }
    }
  ]
}
