{
  "version": 2,
  "description": "Tier-1 회귀 — 라우팅/배지/classifier + OOS 게이트(택시 등) 캘리브레이션",
  "cases": [
    { "id": "external_audit_finance", "query": "외감규정 절차", "expect": { "classifier": "standard", "incident_nodes_exclude": ["정보보안", "회사정보"], "category": "재무" }, "note": "#284 외부 트리거 FP 회귀 — 정보보안 노드로 새면 FAIL" },
    { "id": "pii_leak_infosec", "query": "개인정보 유출", "expect": { "classifier": "critical", "category": "정보보안" } },
    { "id": "safety_report", "query": "안전사고 보고", "expect": { "category": "안전" } },
    { "id": "self_report_faq", "query": "자진 신고", "expect": { "classifier": "simple_faq" } },
    { "id": "harassment_hr", "query": "직장 내 괴롭힘", "expect": { "classifier": "standard", "incident_nodes_include": ["괴롭힘"], "category": "인사" }, "note": "주제어=standard (사건 프레이밍만 critical)" },
    { "id": "taxi_finance", "query": "택시 타도 됨?", "expect": { "classifier_not": "out_of_scope" }, "note": "OOS 오분류 -> 게이트가 시내교통비(재무)로 rescue" },
    { "id": "parking_admin", "query": "회사 주차장", "expect": { "classifier": "out_of_scope" }, "note": "주차 전용 사규 없음(급배기·실종아동 스치는 언급뿐). 게이트가 OOS 유지 = 정답. 스치는 언급에 과잉 rescue 안 하는지 지키는 가드" },
    { "id": "overtime_meal", "query": "야근 식대", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "company_car_accident", "query": "법인차량 사고", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "wedding_congrats", "query": "결혼 경조사비", "expect": { "classifier_not": "out_of_scope" } },
    { "id": "meeting_room_oos", "query": "회의실 예약", "expect": { "classifier": "out_of_scope" } },
    { "id": "weather_oos", "query": "오늘 날씨", "expect": { "classifier": "out_of_scope" } },
    { "id": "salary_oos", "query": "내 연봉", "expect": { "classifier": "out_of_scope" } },
    { "id": "lunch_menu_oos", "query": "점심 메뉴", "expect": { "classifier": "out_of_scope" } },
    { "id": "vpn_oos", "query": "VPN 장애", "expect": { "classifier": "out_of_scope" } }
  ]
}
